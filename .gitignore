# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Generated native folders
/ios/
/android/

# Native build files and credentials
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# Debug logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables and secrets
.env
.env.*
!.env.example

# Supabase local files
supabase/.branches/
supabase/.temp/
supabase/.profiles/

# TypeScript cache
*.tsbuildinfo

# Temporary files
*.tmp
*.temp
*.bak

# Local IDE configuration
.vscode/
.idea/

# Optional local AI tooling
.claude/
.agents/


